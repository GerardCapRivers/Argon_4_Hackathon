# Copy to backend/.env and fill in. Never commit real keys.
GEMINI_API_KEY=
ARGON_MODEL=gemini-4-argon
CHEAP_MODEL=gemini-3.8-flash

# Live coaching (local)
OLLAMA_MODEL=gemma3n
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_NUM_GPU=0          # force CPU if Ollama's CUDA runner crashes
WHISPER_MODEL=small
WHISPER_DEVICE=cuda

# Rendering
RENDER_BACKEND=local
ANTIGRAVITY_AGENT=antigravity-preview-09-2026
DATA_DIR=../data
MAX_VIDEO_SECONDS=30

# Eye-contact training data (training/download.py)
KAGGLE_USERNAME=
KAGGLE_KEY=
